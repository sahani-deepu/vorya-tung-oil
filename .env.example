# ==============================================================================
# NOVA GRAIN — Environment Variables Configuration
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys or .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key (used for public client operations if needed)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Secret Key (SERVER-SIDE ONLY)
# Used exclusively by Next.js server Route Handlers to bypass RLS securely for writing inquiries.
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to browser client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. Resend Transactional Email Configuration
# ------------------------------------------------------------------------------
# Resend API Key (starts with "re_...")
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Email Address (e.g., "NOVA GRAIN Finishes <orders@yourdomain.com>")
# For initial testing before domain verification, you can use: onboarding@resend.dev
RESEND_FROM_EMAIL=NOVA GRAIN Finishes <onboarding@resend.dev>

# Recipient Email for internal administrative inquiry alerts
ADMIN_NOTIFICATION_EMAIL=deepusahani725@gmail.com
